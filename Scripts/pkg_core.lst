# --------------------------------------------------- // Session
# NOTE: no mesa/nvidia-* here on purpose — Scripts/install_gpu_drivers.sh
# auto-detects the GPU and installs the matching one. Not a static list
# entry since exactly one of mesa-only vs mesa+nvidia-open is correct
# per machine, not "install all of these."
hyprland                                               # wlroots-based wayland compositor (required by everything below)
xorg-xwayland                                          # runs X11-only apps inside the Wayland session — not a hard dep of hyprland itself
pipewire                                               # audio/video server
pipewire-alsa                                          # pipewire alsa client
pipewire-pulse                                         # pipewire pulseaudio client
wireplumber                                            # pipewire session manager
networkmanager                                         # network manager, used by waybar's network module + wofi's nmtui
bluez                                                  # bluetooth protocol stack
bluez-utils                                            # bluetooth utility cli
blueman                                                # bluetooth manager gui, launched from waybar's bluetooth module
pacman-contrib                                         # provides checkupdates, used by waybar's custom/pacman module
xdg-desktop-portal-hyprland                            # xdg desktop portal for hyprland
xdg-desktop-portal-gtk                                 # file picker / dbus integration
qt5-wayland                                            # wayland support for qt5 apps
qt6-wayland                                            # wayland support for qt6 apps

# --------------------------------------------------- // Theming
python-pywal                                           # generates the colors waybar/wofi/swaync style.css all @import — nothing themes correctly without this
awww                                                    # wallpaper daemon, paired with pywal by wofi's wallpaper picker (newer fork of swww, same usage)
kitty                                                  # terminal, opened by waybar's network widget (nmtui) and wofi
nerd-fonts                                             # glyphs used by waybar, wofi, and starship
fd                                                      # used by wofi's wallpaper picker and nvim's telescope
materia-gtk-theme                                      # GTK widget theme (Materia-dark) — elifouts/Dotfiles' preference, set in Configs/configs/gtk-{3,4}.0/settings.ini
qogir-icon-theme                                       # icon theme (Qogir-dark) — elifouts/Dotfiles' preference, set in Configs/configs/gtk-{3,4}.0/settings.ini
illogical-impulse-bibata-modern-classic-bin            # cursor theme — from elifouts/Dotfiles' fullinstall.sh package list
nwg-look                                                # GUI to apply/preview the GTK theme (also reads gtk-{3,4}.0/settings.ini)
qt5ct                                                   # Qt5 theming, needed for kate/qt apps to match
qt6ct                                                   # Qt6 theming
kvantum                                                 # svg-based Qt6 theme engine
kvantum-qt5                                             # svg-based Qt5 theme engine

# --------------------------------------------------- // Waybar
waybar
hyprpicker                                             # backs waybar's custom/colorpicker widget

# --------------------------------------------------- // Wofi
wofi

# --------------------------------------------------- // Swaync
swaync
gvfs                                                   # needed for swaync's file actions
libnotify                                              # provides notify-send, used across the stack

# --------------------------------------------------- // Hyprlock
hyprlock
hypridle                                               # idle daemon commonly paired with hyprlock (not included in this repo yet)

# --------------------------------------------------- // Nvim
neovim
git                                                    # plugin manager (lazy.nvim) + gitsigns
less                                                    # pager git/man/etc. expect — not in base pacstrap, so those fail without it
ripgrep                                                # telescope live_grep
unzip                                                  # mason LSP/tool installer
nodejs                                                 # required by the bashls language server (installed via mason)
npm
base-devel                                             # C toolchain for treesitter parser compilation

# --------------------------------------------------- // Starship
starship

# --------------------------------------------------- // Fastfetch
fastfetch                                              # system info fetch tool, runs on every interactive shell via .bashrc

# --------------------------------------------------- // Firewall
firewalld                                              # hardened via Scripts/extra/setup_firewall.sh
fail2ban                                               # bans repeat-offender IPs, sshd jail configured by setup_firewall.sh

# --------------------------------------------------- // Hyprland keybinds
jq                                                      # parses hyprctl -j output for the force-kill and per-monitor screenshot binds
grim                                                    # screenshots
slurp                                                   # region select for screenshots
wl-clipboard                                            # wl-copy, screenshots go to clipboard
pamixer                                                 # volume keys (F10/F11/F12), also the quick-settings volume slider
brightnessctl                                           # quick-settings brightness slider
hyprsunset                                              # blue light filter, Super+Shift+N
quickshell                                              # widget panel, Super+M — see Configs/configs/quickshell/hykr/shell.qml
wlogout                                                 # logout menu, Super+Escape
swayosd                                                  # on-screen volume/brightness display, used by wallpaper.sh if present (guarded, optional)
cliphist                                                # clipboard history, Super+V
matugen                                                 # generates colors.json from wallpaper for theme-switcher's "dynamic" theme

# --------------------------------------------------- // Apps
dolphin                                                 # file manager, Super+E — matches HyDE's own choice, pairs with kate (both KDE)
ark                                                     # archive tool, Dolphin's native extract/compress integration (HyDE uses this too, not file-roller)
kde-cli-tools                                           # file type default associations for Dolphin
qt5-imageformats                                        # image thumbnails in Dolphin
ffmpegthumbs                                            # video thumbnails in Dolphin
kate                                                     # text editor, Super+C
brave-bin                                                # web browser, Super+B (AUR — Brave has no official Arch package)
swayimg                                                  # image viewer, Wayland-native — Dolphin's Open With target for images
celluloid                                                # video player (GTK frontend for mpv) — Dolphin's Open With target for video

# --------------------------------------------------- // SDDM (pixel-sakura theme)
sddm
qt6-declarative
qt6-5compat
qt6-svg
qt6-multimedia
qt6-multimedia-ffmpeg
gst-plugins-base
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
