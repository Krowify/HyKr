{
  "name": "Hyperspace",
  "id": "hyperspace",
  "default_wallpaper": "wallpapers/hyperspace.png",
  "dynamic_colors": true,
  "bar": "quickshell-dock",

  "quickshell": {
    "config": "hyperspace"
  },

  "fastfetch": {
    "logo": {
      "type": "kitty-direct",
      "source": "assets/fastfetch-logo.png",
      "width": 30,
      "height": 15
    }
  },

  "fonts": {
    "family": "JetBrainsMono Nerd Font",
    "family_bold": "JetBrainsMono Nerd Font Bold"
  },

  "hypr": {
    "border_size": 2,
    "gaps_out": 10,
    "rounding": 16,
    "border_gradient": true,
    "border_gradient_angle": 45,

    "blur": {
      "enabled": true,
      "size": 5,
      "passes": 3,
      "vibrancy": 0.25
    }
  }
}
