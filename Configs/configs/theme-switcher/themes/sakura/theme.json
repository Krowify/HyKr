{
  "name": "Sakura",
  "id": "sakura",
  "default_wallpaper": "wallpapers/japan-artistic-5120x2880-25406.jpg",
  "dynamic_colors": true,

  "quickshell": {
    "config": "laptop",
    "layout": "islands",
    "radius": 8,
    "gap": 10,
    "clockSize": 14,
    "dateSize": 13
  },

  "fastfetch": {
    "logo": {
      "type": "file",
      "source": "../default/assets/hykr-logo.txt",
      "padding_top": 4
    }
  },

  "fonts": {
    "family": "JetBrainsMono Nerd Font",
    "family_bold": "JetBrainsMono Nerd Font Bold"
  },

  "hypr": {
    "border_size": 2,
    "gaps_out": 8,
    "rounding": 14,

    "blur": {
      "enabled": true,
      "size": 4,
      "passes": 2,
      "vibrancy": 0.2
    }
  }
}
