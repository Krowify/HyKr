{
  "name": "Default",
  "id": "default",
  "default_wallpaper": "wallpapers/guitar_case.jpg",

  "quickshell": {
    "config": "laptop",
    "layout": "islands",
    "font": "kitty",
    "rounded": true,
    "radius": 15,
    "gap": 8,
    "border": "#a89383",
    "clockSize": 14,
    "dateSize": 14
  },

  "fastfetch": {
    "logo": {
      "type": "file",
      "source": "assets/hykr-logo.txt",
      "padding_top": 4
    }
  },

  "fonts": {
    "family": "JetBrainsMono Nerd Font",
    "family_bold": "JetBrainsMono Nerd Font Bold"
  },

  "hypr": {
    "border_size": 2,
    "gaps_out": 8,
    "rounding": 15,
    "rounding_power": 2.5,

    "blur": {
      "enabled": true,
      "size": 3,
      "passes": 2,
      "vibrancy": 0.1696
    }
  }
}
