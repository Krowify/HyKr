-- Per-machine monitor layout. Copy this to `monitors.lua` (same directory)
-- and edit it for YOUR outputs:
--
--     cp ~/.config/hypr/monitors.lua.example ~/.config/hypr/monitors.lua
--
-- hyprland.lua does an optional `pcall(require, "monitors")`, so with no
-- monitors.lua present Hyprland just uses the `output = ""` catch-all
-- (preferred mode, auto position, auto scale) and everything works.
-- monitors.lua is gitignored, so your layout survives `git pull` and never
-- lands in a commit.
--
-- Get the real values for this machine from:
--
--     hyprctl monitors
--
-- Why this is not in hyprland.lua any more: output names like HDMI-A-1, DP-2
-- and eDP-1 are the first HDMI/DisplayPort/internal panel on almost any
-- machine, so shipping them in the tracked config meant anyone installing
-- HyKr whose output happened to match got the author's resolution, position
-- and -- worst of all -- rotation applied on first login, before they had a
-- terminal open to undo it.
--
-- `transform` is worth pinning when you use it: it is NOT one of the things
-- that survives a config reload on its own. A rotation set live (hyprmod, or
-- a one-off `hyprctl keyword monitor ...`) never gets written back, so
-- without it here every `hyprctl reload` silently resets to unrotated.
--   0 = normal, 1 = 90 deg, 2 = 180 deg, 3 = 270 deg

-- The author's desktop, as an example of the shape:
-- hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@144", position = "0x370", scale = 1, transform = 1 }) -- 90 deg
-- hl.monitor({ output = "DP-2", mode = "2560x1440@240", position = "1080x0", scale = 1, transform = 2 }) -- 180 deg
-- hl.monitor({ output = "DP-3", mode = "1920x1080@239.96", position = "1080x1440", scale = 1 })

-- The author's laptop (MSI Venture A16 AI, 16" FHD+ touch). 1920x1200@60 is
-- MSI's listed spec and has not been confirmed against the actual EDID --
-- check `hyprctl monitors` before trusting it, or just delete the line and
-- let the catch-all in hyprland.lua pick the preferred mode.
-- hl.monitor({ output = "eDP-1", mode = "1920x1200@60", position = "0x0", scale = 1 })
