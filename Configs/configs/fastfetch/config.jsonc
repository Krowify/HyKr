{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/ascii.txt",
        "padding": { "top": 1 },
        "color": { "1": "cyan", "2": "blue" }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "format": "HyKr" },
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
