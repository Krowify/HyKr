{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "raw",
        "source": "~/.config/fastfetch/jirachi.txt",
        "padding": { "top": 1 }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "format": "HyKr" },
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
