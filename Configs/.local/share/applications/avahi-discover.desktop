# Shadows /usr/share/applications/avahi-discover.desktop from the avahi package, which
# can't be uninstalled on its own (it comes in as a dependency) and adds
# launchers to wofi/rofi that nobody needs. Same desktop ID, so this file wins.
[Desktop Entry]
Type=Application
Name=Avahi Zeroconf Browser
Exec=avahi-discover
NoDisplay=true
Hidden=true
